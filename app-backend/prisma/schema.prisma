datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum PostPrivacy {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ChallengeStatus {
  DRAFT
  OPEN
  PENDING_ACCEPTANCE
  ACCEPTED
  ESCROW_PENDING
  ESCROW_LOCKED
  WAITING_ROOM
  READY
  IN_PROGRESS
  MATCH_COMPLETED
  RESULT_SUBMITTED
  RESULT_PENDING_CONFIRMATION
  DISPUTED
  UNDER_REVIEW
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED
} 

enum TransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
  DEPOSIT
  WITHDRAWAL
  CHALLENGE_STAKE
  CHALLENGE_WINNINGS
  PLATFORM_FEE
  BONUS
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                   String        @id @default(uuid())
  firebaseUid          String        @unique
  email                String        @unique
  accountStatus        AccountStatus @default(ACTIVE)
  isVerified           Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  lastActiveAt         DateTime      @default(now())
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  notificationPref     NotificationPreference?
  stats                UserStats?
  role                 UserRole      @default(USER)
  status               UserStatus    @default(ACTIVE)
  moderationLogs       ModerationLog[] @relation("TargetUserLogs")
  adminLogs            ModerationLog[] @relation("AdminUserLogs")

  profile              Profile?
  wallet               Wallet?
  hostedChallenges     Challenge[]   @relation("HostedChallenges")
  joinedChallenges     Challenge[]   @relation("JoinedChallenges")
  wonChallenges        Challenge[]   @relation("WonChallenges")
  transactions         Transaction[]
  postReports          PostReport[]
  statusReactions      StatusReaction[]
  tickets              Ticket[]

  // Social Relations
  playerGames          PlayerGame[]
  following            Follow[]        @relation("UserFollowing")
  followers            Follow[]        @relation("UserFollowers")
  sentRequests         FriendRequest[] @relation("SentFriendRequests")
  recvRequests         FriendRequest[] @relation("ReceivedFriendRequests")
  blockedUsers         Block[]         @relation("BlockedUsers")
  blockedByUsers       Block[]         @relation("BlockedByUsers")
  userGames            UserGame[]

  // Matchmaking Relations
  challengeParticipants ChallengeParticipant[]
  challengeAcceptances  ChallengeAcceptance[]
  sentInvites           ChallengeInvite[]     @relation("SentInvites")
  recvInvites           ChallengeInvite[]     @relation("ReceivedInvites")
  submittedResults      ChallengeResult[]
  disputesRaised        Dispute[]             @relation("DisputesRaised")
  waitingRooms          WaitingRoom[]

  // Financial Relations
  payments              Payment[]
  withdrawals           Withdrawal[]

  // Chat & Call Relations
  conversationMembers   ConversationMember[]
  sentMessages          Message[]             @relation("SentMessages")
  messageReactions      MessageReaction[]
  messageReads          MessageRead[]
  initiatedCalls        Call[]                @relation("InitiatedCalls")
  callParticipants      CallParticipant[]

  // Feed & Notification Relations
  posts                 Post[]
  postLikes             PostLike[]
  postComments          PostComment[]
  postShares            PostShare[]
  statuses              Status[]
  statusViews           StatusView[]
  statusReplies         StatusReply[]

  // Analytics, Support & Governance Relations
  playerStats           PlayerStats[]
  tournament            TournamentParticipant[]
  reportsSubmitted      Report[]                @relation("ReportsSubmitted")
  reportsReceived       Report[]                @relation("ReportsReceived")
  moderationActions     ModerationAction[]      @relation("ModeratorActions")
  searchHistory         SearchHistory[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]  

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Profile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  username          String    @unique
  avatarUrl         String?
  bio               String?
  region            String?
  country           String?
  gender            Gender?
  dateOfBirth       DateTime?
  
  gamingIds         Json      @default("{}")
  
  matchesPlayed     Int       @default(0)
  matchesWon        Int       @default(0)
  matchesLost       Int       @default(0)
  winRate           Float     @default(0.0)
  totalEarnings     Float     @default(0.0)
  
  isVerified        Boolean   @default(false)
  isPrivate         Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum GameStatus {
  ACTIVE
  UPCOMING
  MAINTENANCE
  INACTIVE
}

model Game { 
  id            String        @id @default(uuid())
  title         String        @unique
  slug          String        @unique
  imageUrl      String?       
  iconUrl       String?       
  bannerUrl     String?       
  description   String?       
  isActive      Boolean       @default(true)
  status        GameStatus    @default(ACTIVE) 

  modes         GameMode[]
  challenges    Challenge[]
  playerGames   PlayerGame[]  
  userGames     UserGame[]    
  waitingRooms  WaitingRoom[]
  tournaments   Tournament[]
  playerStats   PlayerStats[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("games")
}

model GameMode {
  id          String   @id @default(uuid())
  name        String   
  description String?
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("game_modes")
} 

model UserGame {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  ign       String   
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@map("user_games")
} 

model UserStats {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamesPlayed   Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  winRate       Float    @default(0.0) 
  rating        Float    @default(1000.0) 
  totalEarnings Float    @default(0.0)
  region        String?  
  gameType      String?  
  updatedAt     DateTime @updatedAt
}

model PlayerGame {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  inGameId  String   
  rank      String?
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@map("player_games")
}

model Follow {
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@map("follows")
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  sender     User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

model Block {
  blockerId String
  blocker   User     @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model ModerationLog {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation("AdminUserLogs", fields: [adminId], references: [id])
  targetUserId String?
  targetUser   User?    @relation("TargetUserLogs", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String   
  reason       String
  createdAt    DateTime @default(now())

  @@map("moderation_logs")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Float         @default(0.0) 
  lockedBalance  Float         @default(0.0) 
  coinBalance    Float         @default(0.0) 
  coinRate       Float         @default(1.0) 
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transactions   Transaction[]

  @@map("wallets")
} 

model CoinRate {
  id        String   @id @default(uuid())
  rate      Float    
  isActive  Boolean  @default(true)
  updatedBy String   
  createdAt DateTime @default(now())
}

model Challenge {
  id           String             @id @default(uuid())
  hostId       String
  host         User               @relation("HostedChallenges", fields: [hostId], references: [id])
  opponentId   String?
  opponent     User?              @relation("JoinedChallenges", fields: [opponentId], references: [id])
  gameId       String
  game         Game               @relation(fields: [gameId], references: [id])
  stakeAmount  Decimal            @db.Decimal(12, 2)
  status       ChallengeStatus    @default(OPEN)
  winnerId     String?
  winner       User?              @relation("WonChallenges", fields: [winnerId], references: [id])
  createdAt    DateTime           @default(now())

  participants ChallengeParticipant[]
  acceptances  ChallengeAcceptance[]
  invites      ChallengeInvite[]
  results      ChallengeResult[]
  disputes     Dispute[]

  @@map("challenges")
}

model Transaction {
  id            String            @id @default(uuid())
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reference     String            @unique 
  status        TransactionStatus @default(SUCCESS)
  metadata      Json?             
  createdAt     DateTime          @default(now()) 

  @@index([walletId])
  @@index([reference])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ResultStatus {
  PENDING
  MATCHED
  CONFLICTED
  VERIFIED
  CONFIRMED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model ChallengeParticipant {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

model ChallengeAcceptance {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedAt  DateTime  @default(now())

  @@map("challenge_acceptances")
}

model ChallengeInvite {
  id          String       @id @default(uuid())
  challengeId String
  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User         @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User         @relation("ReceivedInvites", fields: [receiverId], references: [id], onDelete: Cascade)
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@map("challenge_invites")
}
 
model WaitingRoom {
  id             String    @id @default(cuid())
  challengeId    String    @unique
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  roomCode       String?  
  hostReady      Boolean   @default(false)
  opponentReady  Boolean   @default(false)
  expiresAt      DateTime 
  createdAt      DateTime  @default(now())
}

model ChallengeResult {
  id              String       @id @default(uuid())
  challengeId     String       @unique
  challenge       Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submittedBy     String
  submitter       User         @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
  claimedWinnerId String
  playerScore     Int          @default(0)
  opponentScore   Int          @default(0)
  status          ResultStatus @default(PENDING)
  deadlineAt      DateTime?    
  createdAt       DateTime     @default(now())

  proofs          ResultProof[]

  @@map("challenge_results")
}

model ResultProof {
  id        String          @id @default(uuid())
  resultId  String
  result    ChallengeResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  mediaUrl  String          
  type      String?         
  createdAt DateTime        @default(now())

  @@map("result_proofs")
}

model Dispute {
  id          String        @id @default(uuid())
  challengeId String
  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User          @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  reason      String
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  proofs      DisputeProof[]

  @@map("disputes")
}

model DisputeProof {
  id        String   @id @default(uuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  mediaUrl  String
  createdAt DateTime @default(now())

  @@map("dispute_proofs")
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
}

model WalletLedger {
  id          String          @id @default(uuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [userId], onDelete: Cascade)
  amount      Decimal         @db.Decimal(12, 2)
  type        LedgerEntryType
  description String
  reference   String          @unique
  createdAt   DateTime        @default(now())

  @@map("wallet_ledgers")
}

model Escrow {
  id          String       @id @default(uuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [userId], onDelete: Cascade)
  challengeId String
  amount      Decimal      @db.Decimal(12, 2)
  status      EscrowStatus @default(HELD)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("escrows")
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  provider  String   
  reference String   @unique
  status    String   
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("payments")
}

model Withdrawal {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId      String
  wallet        Wallet           @relation(fields: [walletId], references: [userId], onDelete: Cascade)
  amount        Decimal          @db.Decimal(12, 2)
  bankCode      String
  accountNumber String
  accountName   String
  status        WithdrawalStatus @default(PENDING)
  reference     String           @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("withdrawals")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  SYSTEM
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  ONGOING
  ENDED
  MISSED 
  REJECTED
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType @default(DIRECT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String?             @db.Text
  type           MessageType         @default(TEXT)
  createdAt      DateTime            @default(now())

  attachments    MessageAttachment[]
  reactions      MessageReaction[]
  reads          MessageRead[]

  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@map("message_reads")
}

model Call {
  id          String     @id @default(uuid())
  callerId    String
  caller      User       @relation("InitiatedCalls", fields: [callerId], references: [id], onDelete: Cascade)
  type        CallType   @default(AUDIO)
  status      CallStatus @default(INITIATED)
  startedAt   DateTime   @default(now())
  endedAt     DateTime?

  participants CallParticipant[]

  @@map("calls")
}

model CallParticipant {
  id       String   @id @default(uuid())
  callId   String
  call     Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([callId, userId])
  @@map("call_participants")
}

enum NotificationType {
  FRIEND_REQUEST
  CHALLENGE_INVITE
  CHALLENGE_RESULT
  PAYMENT_SUCCESS
  WITHDRAWAL_SUCCESS
  WITHDRAWAL
  POST_LIKE
  POST_COMMENT
  MESSAGE
  WALLET
  DISPUTE
}

model Post {
  id             String       @id @default(uuid())
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String?      @db.Text
  mediaUrl       String?       
  thumbnailUrl   String?       
  privacy        PostPrivacy  @default(PUBLIC) 
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  media          PostMedia[]
  likes          PostLike[]
  comments       PostComment[]
  shares         PostShare[]
  reports        PostReport[]

  @@map("posts")
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  type      String   
  createdAt DateTime @default(now())

  @@map("post_media")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("post_comments")
}

model PostShare {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("post_shares")
}

model PostReport {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  reason    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_reports")
}

model Status {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  media     StatusMedia[]
  views     StatusView[]
  reactions StatusReaction[]
  replies   StatusReply[]

  @@map("statuses")
}

model StatusMedia {
  id        String   @id @default(uuid())
  statusId  String
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  url       String
  type      String   
  createdAt DateTime @default(now())

  @@map("status_media")
}

model StatusView {
  id       String   @id @default(uuid())
  statusId String
  status   Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([statusId, userId])
  @@map("status_views")
}

model StatusReaction {
  id        String   @id @default(uuid())
  statusId  String
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   
  createdAt DateTime @default(now())

  @@unique([statusId, userId])
  @@map("status_reactions")
}  

model StatusReply {
  id        String   @id @default(uuid())
  statusId  String
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("status_replies")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  metadata  Json?    
  createdAt DateTime         @default(now())
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceType String?  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NotificationPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges    Boolean  @default(true)
  walletUpdates Boolean  @default(true)
  withdrawals   Boolean  @default(true)
  messages      Boolean  @default(true)
  marketing     Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model PlayerStats {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  totalPlayed Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  winRate     Float    @default(0.0)
  rating      Int      @default(1200)

  @@unique([userId, gameId])
  @@map("player_stats")
}

model Leaderboard {
  id        String   @id @default(uuid())
  gameId    String
  period    String   
  rankings  Json
  updatedAt DateTime @updatedAt

  @@map("leaderboards")
}

model Tournament {
  id          String           @id @default(uuid())
  gameId      String
  game        Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  title       String
  entryFee    Decimal          @db.Decimal(12, 2)
  prizePool   Decimal          @db.Decimal(12, 2)
  status      TournamentStatus @default(UPCOMING)
  startDate   DateTime
  createdAt   DateTime         @default(now())

  participants TournamentParticipant[]
  rounds       TournamentRound[]

  @@map("tournaments")
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@map("tournament_participants")
}

model TournamentRound {
  id           String            @id @default(uuid())
  tournamentId String
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber  Int
  matches      TournamentMatch[]

  @@map("tournament_rounds")
}

model TournamentMatch {
  id        String          @id @default(uuid())
  roundId   String
  round     TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player1Id String
  player2Id String
  winnerId  String?
  createdAt DateTime        @default(now())

  @@map("tournament_matches")
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reporter     User         @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?        @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@map("reports")
}

model ModerationAction {
  id          String   @id @default(uuid())
  moderatorId String
  moderator   User     @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)
  action      String   
  targetUserId String
  reason      String
  createdAt   DateTime @default(now())

  @@map("moderation_actions")
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@map("search_histories")
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String       @db.Text
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@map("support_ticket_records")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Ticket {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     TicketCategory @default(GENERAL)
  status       TicketStatus   @default(OPEN) 
  priority     TicketPriority @default(MEDIUM) 
  messages     TicketMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("support_tickets_main")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String   
  message     String
  attachments String[] 
  createdAt   DateTime @default(now())

  @@map("ticket_messages")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  createdAt DateTime @default(now())

  @@map("faqs")
}

enum TicketCategory {
  GENERAL
  BILLING
  TECHNICAL
  GAMEPLAY
  REPORT
  ACCOUNT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}